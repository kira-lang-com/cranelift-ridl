;; A platform caller passes the context in r13 and zero in r12.
function %caller(i64, i64) -> i64 {
    fn0 = %callee(i64 context, i64 error, i64) -> i64, i64 error ridl_system_v

block0(v0: i64, v1: i64):
    v2 = iconst.i64 0
    v3, v4 = call fn0(v0, v2, v1)
    v5 = iadd v3, v4
    return v5
}

