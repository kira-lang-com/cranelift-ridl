;; Windows assigns rcx rdx r8 r9 and xmm0 to xmm3 by position, after 32 bytes
;; of shadow space on the stack.
function %windows_positional(i64, f64, i64, f64, i64) -> i64 ridl_windows_fastcall {
block0(v0: i64, v1: f64, v2: i64, v3: f64, v4: i64):
    v5 = iadd v0, v2
    v6 = iadd v5, v4
    return v6
}

