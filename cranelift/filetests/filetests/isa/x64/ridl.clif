test compile precise-output
set unwind_info=false
target x86_64

;; Integer leaves take rdi rsi rdx rcx r8 r9, then the stack.
function %int_arguments(i64, i64, i64, i64, i64, i64, i64) -> i64 ridl_system_v {
block0(v0: i64, v1: i64, v2: i64, v3: i64, v4: i64, v5: i64, v6: i64):
    v7 = iadd v0, v6
    return v7
}

